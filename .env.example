PORT=3000
FRONTEND_URL=http://localhost:5173
# Con production se activa trust proxy
NODE_ENV=development
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
DATABASE_URL=
JWT_SECRET=
JWT_EXPIRES_IN=8h
SUPER_ADMIN_ID=12345678
# ── Correo (SMTP con Nodemailer) ─────────────────────────────
MAIL_HOST=smtp.gmail.com
MAIL_PORT=465
MAIL_SECURE=true
MAIL_USER=correo-que-envia@gmail.com
# Contraseña de aplicación de Gmail de 16 caracteres (solo variables de entorno).
MAIL_PASS=contraseña-de-aplicacion-de-16-caracteres
MAIL_FROM="Pizzería La Sirena <correo-que-envia@gmail.com>"
# Alias heredado: también se acepta si MAIL_PASS no está presente.
MAIL_APP_PASSWORD=
# ── Datos del local (correo de bienvenida) ───────────────────
LOCAL_DIRECCION=Cra. 45 #104-30, Laureles, Medellín, Antioquia
LOCAL_HORARIO=Jueves a domingo, 4:00 p. m. a 10:00 p. m.
LOCAL_TELEFONO=604 234 5678